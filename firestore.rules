rules_version = '2';

// SiatkaLive access rules. Paste into Firebase console → Firestore → Rules → Publish.
// Everyone can read results. Writing needs a key: the chief referee's PIN, or the key of
// one court. The app sends the key once per device as a "session"; the rules compare it
// with the keys stored in private/pins.
service cloud.firestore {
  match /databases/{database}/documents {
    // Organiser accounts: login, name and the account's tournaments with their PINs,
    // visible only to the account itself.
    // Credits (prepaid visits) are added only by the administrator or the payment system.
    match /accounts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid && !('credits' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']);
    }

    // Visit counter of the service's front page: anyone adds exactly one visit.
    match /stats/{d} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['visits']) && request.resource.data.visits == 1;
      allow update: if request.resource.data.keys().hasOnly(['visits'])
        && request.resource.data.visits == resource.data.visits + 1;
    }

    match /tournaments/{t} {
      function pins() {
        return get(/databases/$(database)/documents/tournaments/$(t)/private/pins).data;
      }
      function session() {
        return get(/databases/$(database)/documents/tournaments/$(t)/sessions/$(request.auth.uid)).data;
      }
      function hasSession() {
        return request.auth != null
          && exists(/databases/$(database)/documents/tournaments/$(t)/sessions/$(request.auth.uid));
      }
      // A session is valid only while its key is still the current one.
      function isAdmin() {
        return hasSession() && session().role == 'admin' && session().pin == pins().adminPin;
      }
      function isAnyCourt() {
        return hasSession() && session().role == 'court'
          && session().pin == pins().courts[string(session().court)];
      }
      function isCourt(c) {
        return isAnyCourt() && session().court == c;
      }

      allow read: if true;
      allow write: if isAdmin();

      // Matches are stored as one sheet per court (documents court-1 … court-9, each with
      // { court, status: 'scheduled', matches: { id: match } }), so the rules below apply
      // to a whole court: its referee may update their court's sheet.
      match /matches/{m} {
        allow read: if true;
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          // A court referee runs the matches of their own court, until the match is finished.
          || (isCourt(resource.data.court) && resource.data.status != 'finished'
              && request.resource.data.court == resource.data.court)
          // Any referee's result may fill in the teams of a knockout match that has not started.
          || ((isAnyCourt()) && resource.data.status == 'scheduled'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamA', 'teamB', 'updatedAt']));
      }

      // Daily visit counters of a tournament (usage/2026-10-24 = { views }): every opening of
      // the tournament's pages adds exactly one.
      match /usage/{day} {
        allow read: if true;
        allow create: if exists(/databases/$(database)/documents/tournaments/$(t))
          && request.resource.data.keys().hasOnly(['views']) && request.resource.data.views == 1;
        allow update: if request.resource.data.keys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1;
      }

      // Sign-ups from the tournament's page (#zgloszenie): anyone sends one while the organiser
      // keeps sign-ups open; the contact details are read only by the organiser.
      match /entries/{e} {
        allow read, update, delete: if isAdmin();
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/tournaments/$(t)).data.tournament.get('registration', false) == true
          && request.resource.data.keys().hasOnly(['name', 'categoryId', 'club', 'contact', 'phone', 'email', 'players', 'logo', 'note', 'status', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() <= 80
          && request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 40
          && request.resource.data.get('club', '').size() <= 80
          && request.resource.data.get('phone', '').size() <= 30
          && request.resource.data.get('email', '').size() <= 120
          && request.resource.data.get('players', '').size() <= 4000
          && request.resource.data.get('note', '').size() <= 1000
          && request.resource.data.get('logo', '').size() <= 60000
          && request.resource.data.status == 'nowe' && request.resource.data.createdAt is int;
      }

      match /private/{d} {
        allow read: if isAdmin();
        // The first setup creates the keys; after that only the admin can change them.
        allow create: if request.auth != null && d == 'pins'
          && request.resource.data.adminPin is string && request.resource.data.adminPin.size() >= 4
          && request.resource.data.courts is map;
        allow update: if isAdmin()
          && request.resource.data.adminPin is string && request.resource.data.adminPin.size() >= 4
          && request.resource.data.courts is map;
      }

      match /sessions/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && (
          (request.resource.data.keys().hasOnly(['role', 'pin'])
            && request.resource.data.role == 'admin' && request.resource.data.pin == pins().adminPin)
          || (request.resource.data.keys().hasOnly(['role', 'pin', 'court'])
            && request.resource.data.role == 'court' && request.resource.data.court is int
            && request.resource.data.pin == pins().courts[string(request.resource.data.court)]));
      }
    }
  }
}
