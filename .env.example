# Copy to .env.local and fill in from Firebase console → Project settings → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: Realtime Database for live scores (Firebase console → Realtime Database).
VITE_FIREBASE_DATABASE_URL=
# Optional: a different id per tournament edition.
VITE_TOURNAMENT_ID=main
