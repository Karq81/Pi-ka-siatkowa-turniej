# Used by `npm run dev:emulator` for local testing without a real Firebase project.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-siatkalive.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-siatkalive
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_DATABASE_URL=https://demo-siatkalive-default-rtdb.firebaseio.com
VITE_USE_EMULATOR=1
